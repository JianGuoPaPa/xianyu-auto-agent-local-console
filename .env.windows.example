# Windows/Ollama example. Copy to .env and replace COOKIES_STR.

API_KEY=ollama
MODEL_BASE_URL=http://127.0.0.1:11434/v1
MODEL_NAME=qwen2.5:3b-instruct
ENABLE_MODEL_SEARCH=False

COOKIES_STR=your_goofish_cookie_here

TOGGLE_KEYWORDS=。
SIMULATE_HUMAN_TYPING=True
MANUAL_MODE_TIMEOUT=3600
MESSAGE_EXPIRE_TIME=300000
LOG_LEVEL=INFO

HEARTBEAT_INTERVAL=15
HEARTBEAT_TIMEOUT=5
TOKEN_REFRESH_INTERVAL=3600
TOKEN_RETRY_INTERVAL=300

DASHBOARD_TOKEN=
AUTO_COOKIE_SYNC_ENABLED=False
COOKIE_SYNC_DEBUG_URL=http://127.0.0.1:9222
AUTO_COOKIE_SYNC_INTERVAL_SECONDS=300
AUTO_COOKIE_SYNC_RETRY_SECONDS=60

