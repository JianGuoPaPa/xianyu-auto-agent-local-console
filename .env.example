# Copy this file to .env and replace placeholders with your own values.

# Required: OpenAI-compatible LLM endpoint.
API_KEY=your_llm_api_key
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen-max

# Required: your own Goofish/Xianyu web cookie.
COOKIES_STR=your_goofish_cookie_here

# Reply behavior.
ENABLE_MODEL_SEARCH=False
TOGGLE_KEYWORDS=。
SIMULATE_HUMAN_TYPING=False
MANUAL_MODE_TIMEOUT=3600
MESSAGE_EXPIRE_TIME=300000
LOG_LEVEL=INFO

# WebSocket/token retry behavior.
HEARTBEAT_INTERVAL=15
HEARTBEAT_TIMEOUT=5
TOKEN_REFRESH_INTERVAL=3600
TOKEN_RETRY_INTERVAL=300

# Optional dashboard/cookie-sync settings.
DASHBOARD_TOKEN=
AUTO_COOKIE_SYNC_ENABLED=False
COOKIE_SYNC_DEBUG_URL=http://127.0.0.1:9222
AUTO_COOKIE_SYNC_INTERVAL_SECONDS=300
AUTO_COOKIE_SYNC_RETRY_SECONDS=60

